# Cloudflare Pages response headers. `vite preview` applies the same rules.
#
# COOP + COEP: cross-origin isolation, required for SharedArrayBuffer (threaded WASM).
# CSP connect-src 'self': the page can't send data to any other origin.
# 'unsafe-eval': wasm-vips' JavaScript bindings (Emscripten embind) build functions with
#   `new Function`. There is no third-party script and no user-supplied HTML on the page.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable
